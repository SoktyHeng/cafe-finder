# Copy to .env.local and fill only what the active milestone needs.
# Never commit real keys. "replace-me" is treated as "not set".

# Runtime
# NODE_ENV is set by Next.js (dev/build/start); do not override it here.
# NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# fixture = offline demo data (default, no keys needed) | google = live Places API (New)
# Changing this requires a rebuild (the demo-mode footer is prerendered).
PLACES_PROVIDER=fixture

# Google Maps browser key: shipped to browsers. Use a SEPARATE key restricted by
# HTTP referrer (your domains) AND to "Maps JavaScript API" only. Without it,
# the map shows a fallback and the list still works. Rebuild after changing.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-me
# Map ID for Advanced Markers (Google Cloud > Map Management). Optional in
# development (Google's DEMO_MAP_ID is used); create a real one for production.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Places API (New) — server only. Restrict the key to "Places API (New)".
# Required when PLACES_PROVIDER=google. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_SERVER_API_KEY=replace-me

# Optional routing — server only
GOOGLE_ROUTES_SERVER_API_KEY=replace-me

# Supabase (M5): sign-in, favorites, saved preferences. Leave unset for guest-only mode.
# Project Settings > API: the project URL and the *publishable* key (browser-safe;
# RLS enforces access). NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as the legacy name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Not used by the app. Only for explicit admin scripts; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Controls
ENABLE_AI=false
# Optional M7 assistant. Rebuild after enabling/disabling (navigation is prerendered).
# openai = Responses API | nvidia = NVIDIA NIM GPT-OSS | fixture = scripted demo (fixture Places only).
AI_PROVIDER=openai
OPENAI_API_KEY=replace-me
# Use an OpenAI project key for api.openai.com. NVIDIA/Foundry credentials cannot authenticate here.
# NVIDIA NIM hosted endpoint: https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY=replace-me
# NVIDIA request cap per process per 24-hour window. Token caps also apply; NVIDIA quotas/credits remain external.
AI_DAILY_REQUEST_LIMIT=50
AI_RATE_LIMIT_PER_MINUTE=5
AI_GLOBAL_RATE_LIMIT_PER_MINUTE=30
# $1 per UTC day per process. Each attempt reserves $0.02, including failed calls.
# In-memory cap resets on restart; configure OpenAI project limits too. 1 USD = 1,000,000 micro USD.
AI_DAILY_BUDGET_MICRO_USD=1000000
ENABLE_COMMUNITY_REPORTS=false
MAX_SEARCH_RADIUS_METERS=15000
# Per-client limits (requests per minute) and a per-server-instance cap on all Places calls
DISCOVERY_RATE_LIMIT_PER_MINUTE=10
PLACE_DETAILS_RATE_LIMIT_PER_MINUTE=30
PLACE_PHOTOS_RATE_LIMIT_PER_MINUTE=60
PLACES_GLOBAL_RATE_LIMIT_PER_MINUTE=120
# true only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel). false = one shared bucket.
TRUST_PROXY=false
