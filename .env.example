# Copy to .env.local and fill only what the active milestone needs.
# Never commit real keys. "replace-me" is treated as "not set".

# Runtime
# NODE_ENV is set by Next.js (dev/build/start); do not override it here.
# NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# fixture = offline demo data (default, no keys needed) | google = live Places API (New)
# Changing this requires a rebuild (the demo-mode footer is prerendered).
PLACES_PROVIDER=fixture

# Google Maps browser key — restrict by website referrer + Maps JavaScript API (M4+)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=replace-me

# Google Places API (New) — server only. Restrict the key to "Places API (New)".
# Required when PLACES_PROVIDER=google. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_SERVER_API_KEY=replace-me

# Optional routing — server only
GOOGLE_ROUTES_SERVER_API_KEY=replace-me

# Supabase (needed in auth/favorites milestone, M5+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Only for explicitly privileged server administration, not standard user endpoints
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Controls
ENABLE_AI=false
ENABLE_COMMUNITY_REPORTS=false
MAX_SEARCH_RADIUS_METERS=15000
# Per-client limits (requests per minute) and a per-server-instance cap on all Places calls
DISCOVERY_RATE_LIMIT_PER_MINUTE=10
PLACE_DETAILS_RATE_LIMIT_PER_MINUTE=30
PLACE_PHOTOS_RATE_LIMIT_PER_MINUTE=60
PLACES_GLOBAL_RATE_LIMIT_PER_MINUTE=120
# true only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel). false = one shared bucket.
TRUST_PROXY=false
